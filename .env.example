# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงก่อนเริ่ม backend
# ค่า port ที่ Express API ใช้รับ request
PORT=3001
# URL ที่ผู้เรียนเข้าถึง frontend ได้; ใช้สร้าง ThaID callback ด้วย
# เมื่อต้องสแกน QR จากมือถือ ให้ใช้ host/โดเมนที่มือถือเข้าถึงได้และลงทะเบียน callback ให้ตรงกัน
APP_BASE_URL=http://localhost:5173
# ใช้เซ็น session cookie; ต้องเป็นข้อความสุ่มยาวอย่างน้อย 32 ตัวอักษร
SESSION_SECRET=
# เปิดบัญชีทดลองสำหรับพัฒนา; จะถูกปิดอัตโนมัติเมื่อ NODE_ENV=production
ENABLE_MOCK_AUTH=false

# ค่าการเชื่อมต่อที่ได้รับจากทีม ThaID; อย่าใส่ค่าคาดเดา
# URL ของ OpenID Connect issuer ของ ThaID
THAID_ISSUER=
# Client ID ของระบบที่ลงทะเบียนกับ ThaID
THAID_CLIENT_ID=
# Client secret หากวิธี client authentication ต้องใช้
THAID_CLIENT_SECRET=
# วิธี client authentication เช่น client_secret_basic, client_secret_post หรือ none
THAID_CLIENT_AUTH_METHOD=
# scope ที่ขอจาก ThaID; ต้องตรงกับสิทธิ์ที่ระบบได้รับอนุมัติ
THAID_SCOPES=openid profile
# subject ของบัญชีที่ได้รับสิทธิ์ผู้ดูแล คั่นหลายค่าด้วย comma
THAID_ADMIN_SUBJECTS=
